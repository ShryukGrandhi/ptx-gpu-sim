//
// 256-bin histogram of the low byte of each 32-bit input, grid-stride loops.
//   histogram_global  every element is a global atomic (red.global.add)
//   histogram_shared  per-CTA privatized bins in shared memory, merged at the end
// With skewed inputs many lanes of a warp hit the same bin and the atomic
// unit has to serialize them.
//
.version 7.0
.target sm_70
.address_size 64

.visible .entry histogram_global(
	.param .u64 histogram_global_param_in,
	.param .u64 histogram_global_param_bins,
	.param .u32 histogram_global_param_n
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<9>;

	ld.param.u64 	%rd1, [histogram_global_param_in];
	ld.param.u64 	%rd2, [histogram_global_param_bins];
	ld.param.u32 	%r1, [histogram_global_param_n];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, %ntid.x;
	mov.u32 	%r4, %tid.x;
	mad.lo.s32 	%r5, %r2, %r3, %r4;
	mov.u32 	%r6, %nctaid.x;
	mul.lo.s32 	%r7, %r6, %r3;
$L__loop:
	setp.ge.u32 	%p1, %r5, %r1;
	@%p1 bra 	$L__exit;
	mul.wide.u32 	%rd5, %r5, 4;
	add.s64 	%rd6, %rd3, %rd5;
	ld.global.u32 	%r8, [%rd6];
	and.b32 	%r9, %r8, 255;
	mul.wide.u32 	%rd7, %r9, 4;
	add.s64 	%rd8, %rd4, %rd7;
	red.global.add.u32 	[%rd8], 1;
	add.s32 	%r5, %r5, %r7;
	bra.uni 	$L__loop;
$L__exit:
	ret;
}

.visible .entry histogram_shared(
	.param .u64 histogram_shared_param_in,
	.param .u64 histogram_shared_param_bins,
	.param .u32 histogram_shared_param_n
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<19>;
	.reg .b64 	%rd<9>;
	.shared .align 4 .b8 hs_bins[1024];

	ld.param.u64 	%rd1, [histogram_shared_param_in];
	ld.param.u64 	%rd2, [histogram_shared_param_bins];
	ld.param.u32 	%r1, [histogram_shared_param_n];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, %ntid.x;
	mov.u32 	%r4, %tid.x;
	mad.lo.s32 	%r5, %r2, %r3, %r4;
	mov.u32 	%r6, %nctaid.x;
	mul.lo.s32 	%r7, %r6, %r3;
	mov.u32 	%r8, hs_bins;
	mov.u32 	%r18, 0;
	mov.u32 	%r9, %r4;
$L__zero:
	setp.ge.u32 	%p1, %r9, 256;
	@%p1 bra 	$L__zeroed;
	shl.b32 	%r10, %r9, 2;
	add.s32 	%r11, %r8, %r10;
	st.shared.u32 	[%r11], %r18;
	add.s32 	%r9, %r9, %r3;
	bra.uni 	$L__zero;
$L__zeroed:
	bar.sync 	0;
$L__loop:
	setp.ge.u32 	%p2, %r5, %r1;
	@%p2 bra 	$L__merge;
	mul.wide.u32 	%rd5, %r5, 4;
	add.s64 	%rd6, %rd3, %rd5;
	ld.global.u32 	%r12, [%rd6];
	and.b32 	%r13, %r12, 255;
	shl.b32 	%r14, %r13, 2;
	add.s32 	%r15, %r8, %r14;
	atom.shared.add.u32 	%r16, [%r15], 1;
	add.s32 	%r5, %r5, %r7;
	bra.uni 	$L__loop;
$L__merge:
	bar.sync 	0;
	mov.u32 	%r9, %r4;
$L__flush:
	setp.ge.u32 	%p3, %r9, 256;
	@%p3 bra 	$L__exit;
	shl.b32 	%r10, %r9, 2;
	add.s32 	%r11, %r8, %r10;
	ld.shared.u32 	%r17, [%r11];
	mul.wide.u32 	%rd7, %r9, 4;
	add.s64 	%rd8, %rd4, %rd7;
	red.global.add.u32 	[%rd8], %r17;
	add.s32 	%r9, %r9, %r3;
	bra.uni 	$L__flush;
$L__exit:
	ret;
}
